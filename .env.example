# ------------------------------------------------------------------------------
# 1. ENTORNO DE LA APLICACIÃ“N
# ------------------------------------------------------------------------------
APP_NAME="Puente Ciudadano ODS 16"
APP_ENV=development                   # development | staging | production
APP_DEBUG=true                        # true en local, false en producciÃ³n
APP_URL=http://localhost/puente_ciudadano

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS MYSQL / MARIADB (XAMPP LOCAL O NUBE)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost                     # 127.0.0.1 o host remoto en la nube (ej: PlanetScale, Railway, CleverCloud)
DB_PORT=3306
DB_DATABASE=puente_ciudadano
DB_USERNAME=root                      # Usuario por defecto en XAMPP es root
DB_PASSWORD=                          # ContraseÃ±a por defecto en XAMPP es vacÃ­a

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÃ“N DE SEGURIDAD Y AUTENTICACIÃ“N
# ------------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_super_segura_aqui_generada_aleatoriamente
SESSION_LIFETIME=120                  # Minutos de duraciÃ³n de sesiÃ³n de orientaciÃ³n

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÃ“N CORS Y CLIENTE FRONTEND
# ------------------------------------------------------------------------------
# URL del frontend para permitir peticiones HTTP y WebSockets
FRONTEND_URL=http://localhost:5500
ALLOWED_ORIGINS="http://localhost,http://localhost:5500,http://127.0.0.1:5500,https://puente-ciudadano-ods16.vercel.app"

# ------------------------------------------------------------------------------
# 5. DESPLIEGUE EN VERCEL (FRONTEND EN LA NUBE)
# ------------------------------------------------------------------------------
VERCEL_ENV=development                # production | preview | development
VERCEL_URL=https://puente-ciudadano-ods16.vercel.app

# URL base de la API backend consumida por el cliente frontend (opcional)
# Dejar vacÃ­o para autodetectar ruta relativa en entornos locales o servidor integrado
PUENTE_API_BASE=

# ------------------------------------------------------------------------------
# 6. INTEGRACIÓN DE VIDEOLLAMADAS DAILY.CO (ODS 16 - ORIENTACIÓN EN VIVO)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratuita en https://dashboard.daily.co/developers
DAILY_API_KEY=tu_daily_api_key_aqui
VITE_DAILY_API_KEY=tu_daily_api_key_aqui
DAILY_DOMAIN=puente-ciudadano.daily.co
DAILY_ROOM_EXPIRATION_HOURS=24        # Tiempo de vigencia de las salas por caso (horas)